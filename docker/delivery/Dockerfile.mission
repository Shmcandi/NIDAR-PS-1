# Dockerfile for Role 3: Delivery Mission Subsystem
# Target: Raspberry Pi 5 (Debian Bookworm aarch64)
FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gpiod \
    libgpiod-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir \
    gpiod \
    pymavlink>=2.4.30 \
    pyserial>=3.5 \
    numpy>=1.24.0

COPY src/delivery_mission/ /app/

CMD ["python3", "delivery_mission_node.py"]
