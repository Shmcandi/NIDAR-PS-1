# Dockerfile for Role 1: Scout Vision Node
# Target: NVIDIA Jetson Orin Nano Super (L4T / CUDA Edge)
FROM python:3.10-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    v4l-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY src/nithin_role1_vision/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY src/nithin_role1_vision/ /app/

CMD ["python3", "vision_node.py", "--camera", "/dev/video0"]
